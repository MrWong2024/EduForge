{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "lint": "eslint .",
    "lint:file": "eslint",
    "lint:file:fix": "eslint --fix",
    "typecheck": "next typegen && tsc --noEmit",
    "test:contracts": "playwright test --config=playwright.contracts.config.ts",
    "test:contracts:list": "playwright test --config=playwright.contracts.config.ts --list",
    "test:browser": "playwright test --config=playwright.browser.config.ts",
    "test:browser:list": "playwright test --config=playwright.browser.config.ts --list"
  },
  "dependencies": {
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.3",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3"
  }
}
