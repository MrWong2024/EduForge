NODE_ENV=development

BACKEND_PORT=5000
FRONTEND_URL=http://localhost:3000

MONGO_URI=mongodb://eduforge_dev_app:<REPLACE_WITH_PASSWORD>@127.0.0.1:27017/eduforge_dev?authSource=eduforge_dev
MONGO_ADMIN_URI=mongodb://eduforge_dev_db_admin:<DEV_DB_ADMIN_PWD>@127.0.0.1:27017/eduforge_dev?authSource=eduforge_dev
MONGO_SERVER_SELECTION_TIMEOUT_MS=5000

# AI Feedback Worker (disabled by default)
AI_FEEDBACK_WORKER_ENABLED=false
# AI_FEEDBACK_WORKER_INTERVAL_MS=10000
# AI_FEEDBACK_WORKER_BATCH_SIZE=5

# AI Feedback Provider
# AI_FEEDBACK_PROVIDER=stub
# AI_FEEDBACK_REAL_ENABLED=false

# Bailian provider example for manual development integration testing.
# Uncomment only when you explicitly want to call Bailian.
# AI_FEEDBACK_PROVIDER=bailian
# AI_FEEDBACK_REAL_ENABLED=true
BAILIAN_API_KEY=
BAILIAN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
BAILIAN_MODEL=qwen3.6-plus
# BAILIAN_TIMEOUT_MS=90000
# BAILIAN_MAX_RETRIES=1
