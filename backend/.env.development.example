NODE_ENV=development

BACKEND_PORT=5000
FRONTEND_URL=http://localhost:3000

MONGO_URI=mongodb://eduforge_dev_app:<REPLACE_WITH_PASSWORD>@127.0.0.1:27017/eduforge_dev?authSource=eduforge_dev
MONGO_ADMIN_URI=mongodb://eduforge_dev_db_admin:<REPLACE_WITH_PASSWORD>@127.0.0.1:27017/eduforge_dev?authSource=eduforge_dev
MONGO_SERVER_SELECTION_TIMEOUT_MS=5000

AI_FEEDBACK_WORKER_ENABLED=true

AI_FEEDBACK_PROVIDER=bailian
BAILIAN_API_KEY=<REPLACE_WITH_API_KEY>
BAILIAN_MODEL=qwen3.6-plus

MAIL_PROVIDER=smtp
MAIL_FROM=noreply@example.com
SMTP_HOST=smtp.example.com
SMTP_USER=noreply@example.com
SMTP_PASS=<REPLACE_WITH_PASSWORD>