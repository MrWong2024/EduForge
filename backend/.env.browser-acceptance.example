# The Browser launcher fixes AI_FEEDBACK_PROVIDER=stub and AI_FEEDBACK_WORKER_ENABLED=false.
# No real AI key is needed; only the three declarations below are read from this file.
EDUFORGE_DATABASE_PURPOSE=browser_acceptance
BROWSER_ACCEPTANCE_APP_MONGO_URI=mongodb://<BROWSER_APP_USER>:<REPLACE_WITH_PASSWORD>@127.0.0.1:27017/eduforge_browser_test?authSource=eduforge_browser_test
BROWSER_ACCEPTANCE_ADMIN_MONGO_URI=mongodb://<BROWSER_ADMIN_USER>:<REPLACE_WITH_PASSWORD>@127.0.0.1:27017/eduforge_browser_test?authSource=eduforge_browser_test
