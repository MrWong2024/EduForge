NODE_ENV=production

BACKEND_PORT=5000
FRONTEND_URL=https://your-domain.example.com

MAIL_PROVIDER=smtp
MAIL_FROM=noreply@mail.cqupt.fun
MAIL_FROM_NAME=EduForge
SMTP_HOST=smtpdm.aliyun.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=noreply@mail.cqupt.fun
SMTP_PASS=replace-with-smtp-password

# MongoDB
# For Alibaba Cloud MongoDB replica set, use the VPC/private connection string.
# Passwords in MongoDB URI must be URL-encoded, for example "$" -> "%24".
MONGO_URI=mongodb://root:<URL_ENCODED_PASSWORD>@<HOST1>:3717,<HOST2>:3717/eduforge?authSource=admin&replicaSet=<REPLICA_SET>
MONGO_ADMIN_URI=mongodb://root:<URL_ENCODED_PASSWORD>@<HOST1>:3717,<HOST2>:3717/eduforge?authSource=admin&replicaSet=<REPLICA_SET>
MONGO_SERVER_SELECTION_TIMEOUT_MS=5000

# AI Feedback Worker: background auto-consumption only; not a global AI switch.
AI_FEEDBACK_WORKER_ENABLED=true
# Validated defaults: enabled=false, interval=10000ms, batch=5; numeric values must be positive integers.
# AI_FEEDBACK_WORKER_INTERVAL_MS=10000
# AI_FEEDBACK_WORKER_BATCH_SIZE=5

# AI Feedback Provider
AI_FEEDBACK_PROVIDER=bailian

# Bailian provider: BAILIAN_API_KEY is required and must be non-blank.
BAILIAN_API_KEY=
BAILIAN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
BAILIAN_MODEL=qwen3.6-plus
# BAILIAN_TIMEOUT_MS=90000
# BAILIAN_MAX_RETRIES=1
