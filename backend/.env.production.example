NODE_ENV=production

BACKEND_PORT=5000
FRONTEND_URL=http://localhost:3000

MONGO_URI=mongodb://eduforge_app:<REPLACE_WITH_PASSWORD>@127.0.0.1:27017/eduforge?authSource=eduforge
MONGO_ADMIN_URI=mongodb://eduforge_db_admin:<PROD_DB_ADMIN_PWD>@<HOST>:27017/eduforge?authSource=eduforge
MONGO_SERVER_SELECTION_TIMEOUT_MS=5000

# AI Feedback Worker (disabled by default)
AI_FEEDBACK_WORKER_ENABLED=false
AI_FEEDBACK_WORKER_INTERVAL_MS=3000
# AI_FEEDBACK_WORKER_BATCH_SIZE=5

# AI Feedback Provider
# AI_FEEDBACK_PROVIDER=stub
# AI_FEEDBACK_REAL_ENABLED=false
BAILIAN_API_KEY=
BAILIAN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
BAILIAN_MODEL=qwen-plus
BAILIAN_TIMEOUT_MS=15000
BAILIAN_MAX_RETRIES=2
